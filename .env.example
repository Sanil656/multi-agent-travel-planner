# Groq LLM API Key (Required)
GROQ_API_KEY=your_groq_api_key_here

# Tavily Search API Key (Required for web search)
TAVILY_API_KEY=your_tavily_api_key_here

# OpenWeather API Key (Required for weather updates)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Aviation Stack API Key (Required for flight info)
AVIATION_STACK_API_KEY=your_aviation_stack_api_key_here

# PostgreSQL database URL (Optional, defaults to memory if empty)
# Use this default for local development outside Docker:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph_memory
# (Note: Inside Docker Compose, this is automatically configured to point to the DB container)

# Groq LLM model selection (Optional, defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
